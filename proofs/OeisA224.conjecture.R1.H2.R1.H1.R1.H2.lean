theorem OMA.solution : OMA.R_OeisA224_conjecture_R1_H2_R1_H1_R1.H2 := by
  intro p q e f hp hq hop hoq hpq hp2 hq2 he hf hsum
  have hp3 : 3≤p := by
    have := hp.two_le
    by_contra! hh
    have : p=2 := by omega
    rw [this] at hop
    norm_num at hop
  exact OMA.ResiduePairs.region OMA.ResiduePairs.smallCover OMA.ResiduePairs.largeCover
    OMA.ResiduePairs.assembled hp hq hop hoq hpq (by decide) (by decide) hp3 (by omega) (by omega) (by omega) he hf hsum
