def smaller (i : ℕ) := (smallerPage (i / 128) >>> (8 * (i % 128))) % 256

def choices (s : ℕ) : List ℕ :=
  (List.range' (offset s) (offset (s + 1) - offset s)).map smaller

def covered (z w : ℕ) : Bool :=
  if z ≤ w ∧ z^2 + w^2 ≤ 69383 then (choices (z^2 + w^2)).contains z else true

def goodTuple (x y z w : ℕ) : Bool :=
  if z ≠ 0 ∧ x^2+y^2+z^2+w^2 = 69383 ∧
      OeisA261876.isSquare ((5*x^2 + 7*y^2 + 9*z^2)*y*z) = true then
    x == 187 && y == 147 && z == 6 && w == 113
  else true

def rightMatches (x y : ℕ) :=
  let s := 69383 - (x^2 + y^2)
  if x^2 + y^2 > 69383 then true else
    (choices s).all fun u =>
      let v := Nat.sqrt (s-u^2)
      goodTuple x y u v && goodTuple x y v u

def row (t : ℕ) := (List.range 264).all fun k => covered t k && rightMatches t k

