lemma unique {x y z w : ℕ} (hz : 0 < z) (hs : x^2 + y^2 + z^2 + w^2 = 69383)
    (hsq : OeisA261876.isSquare ((5*x^2 + 7*y^2 + 9*z^2) * y * z) = true) :
    x = 187 ∧ y = 147 ∧ z = 6 ∧ w = 113 := by
  have bound (t : ℕ) (h : t ^ 2 ≤ 69383) : t < 264 := by
    by_contra! ht
    have hh := Nat.pow_le_pow_left ht 2
    omega
  have checked {a b : ℕ} (ha : a < 264) (hb : b < 264) :
      covered a b = true ∧ rightMatches a b = true :=
    Bool.and_eq_true_iff.mp (List.all_eq_true.mp (all_rows a ha) b (List.mem_range.mpr hb))
  let s := 69383 - (x^2 + y^2)
  have hsbound : x^2 + y^2 ≤ 69383 := by omega
  have pairCheck := (checked (bound x (by omega)) (bound y (by omega))).2
  have inside (u v : ℕ) (huv : u ≤ v) (ht : u^2 + v^2 = s) :
      goodTuple x y u v = true ∧ goodTuple x y v u = true := by
    have hsle : u^2 + v^2 ≤ 69383 := by dsimp [s] at ht; omega
    have c := (checked (bound u (by omega)) (bound v (by omega))).1
    have hc : u ∈ choices (u^2+v^2) := by simpa [covered, huv, hsle] using c
    have mem : u ∈ choices s := ht ▸ hc
    have hr : Nat.sqrt (s-u^2) = v := by rw [← ht]; simp [Nat.sqrt_eq']
    have allCheck : (choices s).all (fun a =>
        goodTuple x y a (Nat.sqrt (s-a^2)) && goodTuple x y (Nat.sqrt (s-a^2)) a) = true := by
      simpa [s, rightMatches, Nat.not_lt.mpr hsbound] using pairCheck
    simpa [hr] using Bool.and_eq_true_iff.mp (List.all_eq_true.mp allCheck u mem)
  have ok : goodTuple x y z w = true := by
    by_cases hzw : z ≤ w
    · exact (inside z w hzw (by dsimp [s]; omega)).1
    · exact (inside w z (by omega) (by dsimp [s]; omega)).2
  simpa [goodTuple, hz.ne', hs, hsq, and_assoc] using ok

lemma indicator_sum (n : ℕ) (hn : 187 < n) :
    (∑ x ∈ Finset.range n, ∑ y ∈ Finset.range n, ∑ z ∈ Finset.Ico 1 n, ∑ w ∈ Finset.range n,
      (if x = 187 ∧ y = 147 ∧ z = 6 ∧ w = 113 then 1 else 0 : ℕ)) = 1 := by
  have h1 : 147 < n := by omega
  have h2 : 6 < n := by omega
  have h3 : 113 < n := by omega
  simp [ite_and, Finset.sum_ite_irrel, hn, h1, h2, h3]

lemma single_count : OeisA261876.a 69383 = 1 := by
  have test (x y z w : ℕ) (hz : 0 < z) :
      (if x^2+y^2+z^2+w^2 == 69383 &&
          OeisA261876.isSquare ((5*x^2+7*y^2+9*z^2)*y*z) then 1 else 0 : ℕ) =
      (if x = 187 ∧ y = 147 ∧ z = 6 ∧ w = 113 then 1 else 0) := by
    congr 1
    apply propext
    constructor
    · intro h
      obtain ⟨hs, hsq⟩ := Bool.and_eq_true_iff.mp h
      exact unique hz (by simpa using hs) hsq
    · rintro ⟨rfl, rfl, rfl, rfl⟩
      decide +kernel
  unfold OeisA261876.a
  calc
    _ = ∑ x ∈ Finset.range 69384, ∑ y ∈ Finset.range 69384,
        ∑ z ∈ Finset.Ico 1 69384, ∑ w ∈ Finset.range 69384,
          (if x = 187 ∧ y = 147 ∧ z = 6 ∧ w = 113 then 1 else 0) := by
      refine Finset.sum_congr rfl fun x _ => Finset.sum_congr rfl fun y _ =>
        Finset.sum_congr rfl fun z hz => Finset.sum_congr rfl fun w _ => ?_
      exact test x y z w (Finset.mem_Ico.mp hz).1
    _ = 1 := indicator_sum _ (by decide)

