open OeisA261876 OMA.SquarePairs in
theorem OMA.solution : type_of% @OeisA261876.conjecture_2 := by
  intro hall
  obtain ⟨k, m, hm, hn⟩ := (hall 69383).mp single_count
  cases k with
  | zero =>
    simp only [pow_zero, one_mul] at hn
    subst m
    exact (by decide : 69383 ∉ specialSet) hm
  | succ k =>
    have h4 : 4 ∣ 69383 := by rw [hn, pow_succ]; exact ⟨4^k * m, by ring⟩
    omega
