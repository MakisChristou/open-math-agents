def pick (n : ℕ) := if Nat.gcd n tree.value = 1 then n else tree.first n
def row (i : ℕ) :=
  let n := 6*(i/2)+1+4*(i%2)
  if n=1 then table n==0 else
  let p := pick n
  if p=n then table n == valP n else table n == (valP p+table (n/p))%7
def weight : ℕ → ℕ → ℕ
  | 0, _ => 0
  | j+1, n =>
    if n%2=0 then (1+weight j (n/2))%7 else
    if n%3=0 then weight j (n/3) else table n
def adjacent (n : ℕ) := weight 21 n != 0 || weight 21 (n+1) != 0
def run (f : ℕ → Bool) (i : ℕ) : ℕ → Bool
  | 0 => true
  | k+1 => f (i+k) && run f i k

def runPow (b : ℕ) (f : ℕ → Bool) : ℕ → ℕ → Bool
  | 0, _ => true
  | j+1,x => x≥1649375 || (f x && runPow b f j (x*b))
def covered (i : ℕ) :=
  let r := 6*(i/2)+1+4*(i%2)
  let a := (7 - table r%7)%7
  runPow 128 (runPow 3 (fun x => weight 21 (x+1)%7 != 0) 14) 3 (r*2^a)
def both (i : ℕ) := row i && covered i
def mass (n : ℕ) : ZMod 7 :=
  n.factorization.sum (fun q e => (e : ZMod 7) * (valP q : ZMod 7))

lemma mass_one : mass 1=0 := by simp [mass]
lemma mass_prime {p : ℕ} (hp : p.Prime) : mass p=(valP p : ZMod 7) := by
  simp [mass,hp.factorization]
lemma mass_mul {u v : ℕ} (hu : 0<u) (hv : 0<v) : mass (u*v)=mass u+mass v := by
  unfold mass
  rw [Nat.factorization_mul (by omega) (by omega)]
  apply Finsupp.sum_add_index
  · simp
  · intros; push_cast; ring

/-- Divisor witnesses for the primality test up to the table bound. -/
def common (a : ℕ) : ℕ → ℕ
  | 0 => a+1
  | k+1 => Nat.lcm (common a k) (common (a+2^k) k)

lemma in_common (d a k : ℕ) (hlo : a<d) (hhi : d≤a+2^k) : d ∣ common a k := by
  induction k generalizing a with
  | zero => have h : d=a+1 := by simp at hhi; omega
            simp [common,h]
  | succ k ih =>
    simp only [common]
    by_cases h : d≤a+2^k
    · exact (ih _ hlo h).trans (Nat.dvd_lcm_left ..)
    · have h' : d≤a+2^k+2^k := by rw [pow_succ] at hhi; omega
      exact (ih _ (by omega) h').trans (Nat.dvd_lcm_right ..)

lemma prime_of_leaf {p : ℕ} (h : leafPrime p=true) : p.Prime := by
  unfold leafPrime at h
  split_ifs at h with hs
  · have hm := of_decide_eq_true h
    simp only [List.mem_cons,List.not_mem_nil,or_false] at hm
    rcases hm with h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h|h <;> rw [h] <;> decide +kernel
  · obtain ⟨hb,hg⟩ := of_decide_eq_true h
    by_contra hc
    have hp := Nat.minFac_prime (by omega : p≠1)
    have hq := Nat.minFac_sq_le_self (by omega) hc
    have hle : p.minFac≤64 := by nlinarith
    have hd := in_common p.minFac 0 6 hp.pos (by simpa using hle)
    rw [show common 0 6=smallMag by decide +kernel] at hd
    have hh := Nat.dvd_gcd (Nat.minFac_dvd p) hd
    rw [hg] at hh
    exact hp.ne_one (Nat.dvd_one.mp hh)
lemma first_sound (t : PrimeTree) (n : ℕ) (hv : t.valid=true)
    (hg : ¬ n.Coprime t.value) : (t.first n).Prime ∧ t.first n ∣ n := by
  induction t with
  | leaf p =>
    have hp : p.Prime := prime_of_leaf hv
    exact ⟨hp,hp.dvd_iff_not_coprime.mpr (fun h => hg h.symm)⟩
  | branch p l r il ir =>
    simp only [PrimeTree.valid,Bool.and_eq_true,beq_iff_eq] at hv
    change ¬ n.Coprime p at hg
    rw [hv.1.1,Nat.coprime_mul_iff_right] at hg
    by_cases hl : n.Coprime l.value
    · have hh : Nat.gcd n l.value = 1 := hl
      simpa only [PrimeTree.first,hh,if_true] using ir hv.2 (fun hr => hg ⟨hl,hr⟩)
    · have hh : Nat.gcd n l.value ≠ 1 := hl
      simpa only [PrimeTree.first,hh,if_false] using il hv.1.2 hl

lemma tree_valid : tree.valid=true := by decide +kernel
lemma in_tree (p : ℕ) (hp : p.Prime) (hb : p≤1285) : p ∣ tree.value := by
  have cert : common 0 10 ∣ tree.value^11 ∧ common 261 10 ∣ tree.value^11 := by decide +kernel
  apply hp.dvd_of_dvd_pow
  by_cases h : p≤1024
  · exact (in_common p 0 10 hp.pos (by simpa using h)).trans cert.1
  · exact (in_common p 261 10 (by omega) (by norm_num; omega)).trans cert.2

lemma pick_ok {n : ℕ} (hn : 1<n) (hb : n≤1649376) : (pick n).Prime ∧ pick n ∣ n := by
  unfold pick
  split_ifs with h
  · refine ⟨?_,dvd_rfl⟩
    by_contra hc
    have hp := Nat.minFac_prime (by omega : n≠1)
    have hs := Nat.minFac_sq_le_self (by omega) hc
    have hle : n.minFac≤1285 := by nlinarith
    have dd := Nat.dvd_gcd (Nat.minFac_dvd n) (in_tree _ hp hle)
    rw [h] at dd
    exact hp.ne_one (Nat.dvd_one.mp dd)
  · exact first_sound tree n tree_valid h

lemma recover {n : ℕ} (h2 : n%2≠0) (h3 : n%3≠0) :
    let i := 2*(n/6)+(n%6)/5
    6*(i/2)+1+4*(i%2)=n := by
  have ha : n%6%2=n%2 := Nat.mod_mod_of_dvd _ (by decide)
  have hb : n%6%3=n%3 := Nat.mod_mod_of_dvd _ (by decide)
  have hrem : n%6=1 ∨ n%6=5 := by omega
  dsimp
  rcases hrem with h|h <;> rw [h] <;> omega
lemma tab_mass (cert : ∀ i < 549792, row i=true) (n : ℕ) (hpos : 0<n)
    (hb : n≤1649376) (h2 : n%2≠0) (h3 : n%3≠0) : (table n : ZMod 7)=mass n := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
    let i := 2*(n/6)+(n%6)/5
    have ind : i<549792 := by dsimp [i]; omega
    have expand : 6*(i/2)+1+4*(i%2)=n := recover h2 h3
    have hc := cert i ind
    simp only [row,expand] at hc
    by_cases hone : n=1
    · rw [hone]
      exact (by decide +kernel : (table 1 : ZMod 7)=0) |>.trans mass_one.symm
    have ⟨hp,hd⟩ := pick_ok (n:=n) (by omega) hb
    by_cases he : pick n=n
    · simp only [hone,if_false,he,if_true,beq_iff_eq] at hc
      rw [hc,mass_prime (he ▸ hp)]
    · simp only [hone,he,if_false,beq_iff_eq] at hc
      let p := pick n
      let m := n/p
      have hm : p*m=n := Nat.mul_div_cancel' hd
      have hpp : 1<p := hp.one_lt
      have hmpos : 0 < m := Nat.div_pos (Nat.le_of_dvd hpos hd) hp.pos
      have hml : m<n := Nat.div_lt_self hpos hpp
      have h2m : m%2≠0 := by
        intro hh
        exact h2 (Nat.mod_eq_zero_of_dvd ((Nat.dvd_of_mod_eq_zero hh).trans ⟨p,by rw [mul_comm,hm]⟩))
      have h3m : m%3≠0 := by
        intro hh
        exact h3 (Nat.mod_eq_zero_of_dvd ((Nat.dvd_of_mod_eq_zero hh).trans ⟨p,by rw [mul_comm,hm]⟩))
      have hmrec := ih m hml hmpos (by omega) h2m h3m
      have hcast := congrArg (fun a : ℕ => (a : ZMod 7)) hc
      have hn : mass n = (valP p : ZMod 7)+mass m := by
        conv_lhs => rw [← hm,mass_mul hp.pos hmpos,mass_prime hp]
      rw [hn, ← hmrec]
      simpa only [ZMod.natCast_mod, Nat.cast_add] using hcast

lemma weight_mass (cert : ∀ i < 549792, row i=true) (j n : ℕ)
    (hf : n<2^j) (hpos : 0<n) (hb : n≤1649376) : (weight j n : ZMod 7)=mass n := by
  induction j generalizing n with
  | zero => simp at hf; omega
  | succ j ih =>
    rw [pow_succ] at hf
    by_cases h2 : n%2=0
    · have hm : 2*(n/2)=n := by omega
      have hp : 0<n/2 := by omega
      have hrec := ih (n/2) (by omega) hp (by omega)
      have h : mass n = (1:ZMod 7)+mass (n/2) := by
        conv_lhs => rw [← hm,mass_mul (by decide) hp,mass_prime Nat.prime_two]
        rfl
      simp [weight,h2,h,hrec]
    · by_cases h3 : n%3=0
      · have hm : 3*(n/3)=n := by omega
        have hp : 0<n/3 := by omega
        have hrec := ih (n/3) (by omega) hp (by omega)
        have h : mass n = (0:ZMod 7)+mass (n/3) := by
          conv_lhs => rw [← hm,mass_mul (by decide) hp,mass_prime Nat.prime_three]
          rfl
        simp [weight,h2,h3,h,hrec]
      · simpa [weight,h2,h3] using tab_mass cert n hpos hb h2 h3


lemma power_sound (b : ℕ) (hb : 0<b) (f : ℕ → Bool) (j x : ℕ)
    (h : runPow b f j x=true) (t : ℕ) (ht : t<j) (hx : x*b^t<1649375) :
    f (x*b^t)=true := by
  induction j generalizing x t with
  | zero => omega
  | succ j ih =>
    have hx0 : x<1649375 := (Nat.le_mul_of_pos_right x (Nat.pow_pos hb)).trans_lt hx
    simp only [runPow,decide_eq_false (by omega : ¬ x≥1649375),Bool.false_or,Bool.and_eq_true] at h
    cases t with
    | zero => simpa using h.1
    | succ t =>
      have eq : x*b^(t+1)=x*b*b^t := by rw [pow_succ]; ring
      rw [eq] at hx ⊢
      exact ih (x*b) h.2 t (by omega) hx

lemma split23 (n : ℕ) (hn : 0<n) :
    ∃ r a b : ℕ, 0<r ∧ r%2≠0 ∧ r%3≠0 ∧ n=r*2^a*3^b := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
    by_cases h2 : n%2=0
    · obtain ⟨r,a,b,hr,hr2,hr3,he⟩ := ih (n/2) (Nat.div_lt_self hn (by decide)) (by omega)
      refine ⟨r,a+1,b,hr,hr2,hr3,?_⟩
      calc n = 2*(n/2) := by omega
           _ = _ := by rw [he,pow_succ]; ring
    · by_cases h3 : n%3=0
      · obtain ⟨r,a,b,hr,hr2,hr3,he⟩ := ih (n/3) (Nat.div_lt_self hn (by decide)) (by omega)
        refine ⟨r,a,b+1,hr,hr2,hr3,?_⟩
        calc n = 3*(n/3) := by omega
             _ = _ := by rw [he,pow_succ]; ring
      · exact ⟨n,0,0,hn,h2,h3,by simp⟩

lemma mass_pow (p : ℕ) (hp : 0<p) (k : ℕ) : mass (p^k)=(k:ZMod 7)*mass p := by
  induction k with
  | zero => simp [mass_one]
  | succ k ih => rw [pow_succ,mass_mul (Nat.pow_pos hp) hp,ih,Nat.cast_succ]; ring

lemma no_neighbor (checks : ∀ i < 549792, both i=true) (n : ℕ) (hn : 0<n) (hb : n<1649375)
    (hz : mass n=0) : mass (n+1)≠0 := by
  have rows (i) (hi : i<549792) := (Bool.and_eq_true_iff.mp (checks i hi)).1
  obtain ⟨r,a,b,hr,hr2,hr3,he⟩ := split23 n hn
  have hrn : r≤n := by rw [he]; exact (Nat.le_mul_of_pos_right _ (by positivity)).trans (Nat.le_mul_of_pos_right _ (by positivity))
  have hrm := tab_mass rows r hr (by omega) hr2 hr3
  have hm2 : mass 2=1 := (mass_prime Nat.prime_two).trans (by rfl)
  have hm3 : mass 3=0 := (mass_prime Nat.prime_three).trans (by rfl)
