private def charges (q : ℕ) : ZMod 7 :=
  if q ∈ ([3,41] : List ℕ) then 0 else
  if q ∈ ([79,137,197,233,269,277,463,467,797,1709,2647,2903,15791] : List ℕ) then 2 else 1

private lemma cast_charge (q : ℕ) : (OMA.Seventh.valP q : ZMod 7)=charges q := by
  unfold OMA.Seventh.valP charges
  simp only [Bool.or_eq_true,decide_eq_true_eq,List.mem_cons,List.not_mem_nil,or_false]
  split_ifs <;> first | rfl | omega

theorem OMA.solution : OMA.R_Erdos436_erdos_436_variants_seven_two_R1.H2 := by
  change ∀ n : ℕ, 1≤n → n<1649375 →
    (∑ q ∈ n.primeFactors, (n.factorization q : ZMod 7)*charges q) ≠ 0 ∨
    (∑ q ∈ (n+1).primeFactors, ((n+1).factorization q : ZMod 7)*charges q) ≠ 0
  intro n hn hb
  have he (m : ℕ) : OMA.Seventh.mass m = ∑ q ∈ m.primeFactors, (m.factorization q : ZMod 7)*charges q := by
    unfold OMA.Seventh.mass Finsupp.sum
    simp only [Nat.support_factorization,cast_charge]
  rw [← he,← he]
  by_cases h : OMA.Seventh.mass n=0
  · exact Or.inr (OMA.Seventh.no_neighbor OMA.Seventh.complete n hn hb h)
  · exact Or.inl h
