lemma digit_bound (n : ℕ) (h : IsStrongGiuga n) : 13000 < (Nat.digits 10 n).length := by
  by_contra! hd
  have hL := budget (n := n) (L := 173334) (Nat.zero_lt_of_lt h.1.1) hd (by decide +kernel)
  by_cases h3 : 3 ∈ n.primeFactors
  · exact case1Impossible h hL (by simpa using h3) (by simp)

  · by_cases h5 : 5 ∈ n.primeFactors
    · exact case2Impossible h hL (by simpa using h5) (by simpa using h3)
    · exact case3Impossible h hL (by simp) (by simp only [List.mem_cons,List.not_mem_nil,or_false]; rintro p (rfl|rfl); exact h3; exact h5)

end
end OMA.GiugaBounds

theorem OMA.solution : type_of% @AgohGiuga.agoh_giuga.variants._13000_le_digits_length_of_isStrongGiuga := by
