set_option maxRecDepth 100000 in
lemma indices : rows.map Sigma.fst = List.range 1303 := by decide +kernel

lemma witness {q : ℕ} (hp : q.Prime) (h5 : 5≤q) (hq : q≤1000000) : ∃ v, certOK q v=true := by
  obtain hc|ho := hp.eq_two_or_odd
  · omega
  have h3 : ¬3∣q := by
    intro hd
    have := (Nat.dvd_prime hp).mp hd
    omega
  have hres : q%6=1 ∨ q%6=5 := by
    omega
  let i := 2*(q/6)+(if q%6=1 then 0 else 1)
  have hi : qAt i=q := by
    unfold qAt i
    rcases hres with h|h <;> simp [h] <;> omega
  have hb : i/256 < 1303 := by dsimp [i]; split <;> omega
  have hm : i/256 ∈ rows.map Sigma.fst := by rw [indices,List.mem_range]; exact hb
  obtain ⟨row,_,he⟩ := List.mem_map.mp hm
  have hj := checkedAt row.2.2 (j:=i%256) (by omega)
  have heq : 256*row.1+i%256=i := by omega
  rwa [heq,hi] at hj

end OMA.Timely

theorem OMA.solution : OMA.R_OeisA135508_conjecture_R1_H2_R1.H1 := by
  intro q hp h5 hq
  obtain ⟨v,hv⟩ := OMA.Timely.witness hp h5 hq
  exact OMA.Timely.sound hp h5 hq hv
