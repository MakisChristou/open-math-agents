import OMAReductions.R_OeisA135508_conjecture_R1_H2_R1

/-! Each prime in the prescribed interval has a witness of the form kq − 2.
For large witnesses primality follows from coprimality with all primes up
to 16384, since the largest witness is below 16384 squared. -/

namespace OMA.Timely

/-- Least common multiple of the integers from 1 to 16384. -/
def smallProduct : ℕ := 

def earlyProduct : ℕ := 0x8b6b72b1e90d10fc5a7c5fa4ff1061c4d61d61478b2780

def primeOK (r : ℕ) : Bool :=
  if r ≤ 128 then decide r.Prime else if r ≤ 16384 then decide (r.Coprime earlyProduct)
  else decide (r<16384^2 ∧ r.Coprime smallProduct)

def qAt (i : ℕ) := 6*(i/2)+(if i%2=0 then 1 else 5)

def compositeOK (q : ℕ) : Bool :=
  if q≤128 then decide (¬q.Prime) else if q≤16384 then decide (¬q.Coprime earlyProduct)
  else decide (¬q.Coprime smallProduct)

def certOK (q k : ℕ) : Bool :=
  if k=0 then decide (q<5 ∨ 1000000<q) || compositeOK q else
    let r := k*q-2
    primeOK r && decide (5<r ∧ r<q^2 ∧ r%3=2 ∧ (r+2)%q=0)

/-- A zero bit marks a composite candidate. A one bit is followed by six
bits specifying the multiplier within its residue class modulo six. -/
def decode (q word : ℕ) := if word%2=0 then 0 else 6*((word/2)%64)+q%6

def checks : ℕ → ℕ → ℕ → Bool
  | 0, _, _ => true
  | k+1, i, word =>
    certOK (qAt i) (decode (qAt i) word) &&
      checks k (i+1) (if word%2=0 then word/2 else word/128)

def blockOK (block word : ℕ) := checks 256 (256*block) word

lemma checkedAt {n i word : ℕ} (h : checks n i word=true) {j : ℕ} (hj : j<n) :
    ∃ k, certOK (qAt (i+j)) k=true := by
  induction n generalizing i word j with
  | zero => omega
  | succ n ih =>
    obtain ⟨hfirst,hnext⟩ := Bool.and_eq_true_iff.mp h
    cases j with
    | zero => simpa using (show ∃ k, certOK (qAt i) k=true from ⟨_,hfirst⟩)
    | succ j =>
      have hrec := ih hnext (show j<n by omega)
      simpa only [show i+1+j=i+(j+1) by omega] using hrec

/-- The least common multiple over a dyadic interval, computed by bisection. -/
def intervalLCM (a : ℕ) : ℕ → ℕ
  | 0 => a+1
  | k+1 => Nat.lcm (intervalLCM a k) (intervalLCM (a+2^k) k)

lemma dvdInterval (d a k : ℕ) (ha : a<d) (hb : d≤a+2^k) : d ∣ intervalLCM a k := by
  induction k generalizing a with
  | zero =>
    simp only [pow_zero] at hb
    simpa [intervalLCM] using (show d∣a+1 from (show d=a+1 by omega) ▸ dvd_refl _)
  | succ k ih =>
    rw [intervalLCM]
    rw [pow_succ] at hb
    by_cases hm : d≤a+2^k
    · exact Nat.dvd_lcm_of_dvd_left (ih a ha hm) _
    · exact Nat.dvd_lcm_of_dvd_right (ih (a+2^k) (by omega) (by omega)) _

lemma productSpec : intervalLCM 0 14 = smallProduct := by decide +kernel

lemma smallDvd {p : ℕ} (hp : p.Prime) (hb : p≤16384) : p ∣ smallProduct := by
  rw [←productSpec]
  exact dvdInterval p 0 14 hp.pos hb
lemma earlySpec : intervalLCM 0 7 = earlyProduct := by decide +kernel

lemma primeOfCheck {r : ℕ} (h : primeOK r=true) : r.Prime := by
  unfold primeOK at h
  split at h
  · exact of_decide_eq_true h
  · rename_i hb
    by_contra hnp
    have hsq := Nat.minFac_sq_le_self (by omega : 0<r) hnp
    have hp := Nat.minFac_prime (by omega : r≠1)
    apply hp.ne_one
    split at h
    · rename_i ht
      have hB : r.minFac ≤ 128 := by nlinarith
      apply Nat.eq_one_of_dvd_coprimes (of_decide_eq_true h) (Nat.minFac_dvd r)
      rw [←earlySpec]
      exact dvdInterval _ 0 7 hp.pos hB
    · obtain ⟨hr,hg⟩ := of_decide_eq_true h
      have hB : r.minFac ≤ 16384 := by nlinarith
      exact Nat.eq_one_of_dvd_coprimes hg (Nat.minFac_dvd r) (smallDvd hp hB)

lemma primeDvdInterval {q : ℕ} (hp : q.Prime) (a k : ℕ) (hd : q ∣ intervalLCM a k) :
    q ≤ a+2^k := by
  induction k generalizing a with
  | zero => simpa [intervalLCM] using Nat.le_of_dvd (Nat.succ_pos a) hd
  | succ k ih =>
    rw [intervalLCM,hp.dvd_lcm] at hd
    rw [pow_succ]
    rcases hd with hl|hr
    · have := ih a hl
      omega
    · have := ih (a+2^k) hr
      omega

lemma notComposite {q : ℕ} (hp : q.Prime) : compositeOK q=false := by
  unfold compositeOK
  split
  · simp [hp]
  · rename_i hsmall
    split
    · have hc : q.Coprime earlyProduct := hp.coprime_iff_not_dvd.mpr (by
        rw [←earlySpec]
        intro hd
        exact hsmall (primeDvdInterval hp 0 7 hd))
      simp [hc]
    · rename_i h
      have hc : q.Coprime smallProduct := hp.coprime_iff_not_dvd.mpr (by
        rw [←productSpec]
        intro hd
        exact h (primeDvdInterval hp 0 14 hd))
      simp [hc]

lemma sound {q v : ℕ} (hp : q.Prime) (h5 : 5≤q) (hq : q≤1000000) (hv : certOK q v=true) :
    ∃ r : ℕ, r.Prime ∧ 5<r ∧ r<q^2 ∧ r%3=2 ∧ q ∣ r+2 := by
  unfold certOK at hv
  split at hv
  · simp [notComposite hp,show ¬q<5 by omega,show ¬1000000<q by omega] at hv
  · obtain ⟨hPrime,hrest⟩ := Bool.and_eq_true_iff.mp hv
    obtain ⟨h1,h2,h3,h4⟩ := of_decide_eq_true hrest
    exact ⟨_,primeOfCheck hPrime,h1,h2,h3,Nat.dvd_of_mod_eq_zero h4⟩

