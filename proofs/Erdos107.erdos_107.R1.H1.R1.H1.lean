lemma blockIndices : blocks.map Subtype.val = List.range 318 := by decide +kernel

lemma verified {i : ℕ} (hi : i ≤ 5087) : validRow i=true := by
  have hm : i/16 ∈ blocks.map Subtype.val := by rw [blockIndices,List.mem_range]; omega
  obtain ⟨b,_,he⟩ := List.mem_map.mp hm
  have hj := List.all_eq_true.mp b.property (i%16) (List.mem_range.mpr (by omega))
  rwa [show 16*b.val+i%16=i by omega] at hj

lemma result (color : I→I→I→Bool) (hc : Valid color) : Pentagon color := by
  by_contra hn
  have allSat : ∀ i : ℕ, 0 < i → i ≤ 5087 → Sat (value color) (database i) := by
    intro i
    induction i using Nat.strong_induction_on with
    | h i ih =>
      intro hpos htop
      have h := verified htop
      simp only [validRow,if_neg (show ¬(i=0 ∨ 5087 < i) by omega)] at h
      split at h
      · obtain ⟨hs,he⟩ := Bool.and_eq_true_iff.mp h
        rw [←eq_of_same he]
        exact source_sound hc hn hs
      · exact checked_sound (fun j hj hji => ih j hji hj (by omega)) h
  obtain ⟨j,hj⟩ := allSat 5087 (by decide) (by decide)
  have hempty : database 5087 = ⟨0,0⟩ := rfl
  rw [hempty] at hj
  cases (value color j) <;> simp_all

