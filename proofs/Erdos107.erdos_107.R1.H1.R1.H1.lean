def point (w j : ℕ) : I := Fin.ofNat 9 ((w >>> (4*j))%16)

def source (i : ℕ) : Bool × Clause :=
  let w := (seedWords (i/32) >>> (29*(i%32))) % 2^29
  let p := w >>> 20
  let a := point w 0
  let b := point w 1
  let c := point w 2
  let d := point w 3
  if i≤1008 then (quadOK a b c d p,literals (quadL a b c d p))
  else let s := [a,b,c,d,point w 4]
       (decide (s.toFinset.card=5),literals (fiveL s p))

lemma source_sound {color : I→I→I→Bool} (hc : Valid color) (hn : ¬Pentagon color)
    {i : ℕ} (hs : (source i).1=true) : Sat (value color) (source i).2 := by
  simp only [source] at hs ⊢
  split at hs
  · rename_i h
    simp only [h,if_true]
    exact quad_sound color hc hs
  · rename_i h
    simp only [h,if_false]
    exact five_sound color hn _ _ (of_decide_eq_true hs)

def same (c d : Clause) := (c.pos==d.pos) && (c.neg==d.neg)

lemma eq_of_same {c d : Clause} (h : same c d=true) : c=d := by
  obtain ⟨hp,hn⟩ := Bool.and_eq_true_iff.mp h
  cases c; cases d
  congr 1
  · exact eq_of_beq hp
  · exact eq_of_beq hn

def validRow (i : ℕ) :=
  if i = 0 ∨ 5087 < i then true else
  if i ≤ 2016 then (source i).1 && same (source i).2 (database i)
  else checked database 8192 56 i (tape i)

def validBlock (b : ℕ) := (List.range 16).all fun j => validRow (16*b+j)
abbrev Block := {b : ℕ // validBlock b=true}

