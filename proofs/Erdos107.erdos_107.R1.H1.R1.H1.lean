import OMAReductions.R_Erdos107_erdos_107_R1_H1_R1

/-! The nine-point convex-pentagon theorem in the orientation formulation
of Szekeres and Peters. A convex five-set exists if the color of every
ordered triple in it depends only on its middle vertex. A finite resolution
certificate excludes all allowed orientations without such a five-set. Positive and negative literals are stored in separate bit masks.
Every resolution step preserves the existence of a true literal. -/

namespace OMA.NinePoints

structure Clause where
  pos : ℕ
  neg : ℕ

def Sat (v : ℕ → Bool) (c : Clause) : Prop :=
  ∃ j, (if v j then c.pos else c.neg).testBit j=true

def combineAt (a b : Clause) (j : ℕ) : Clause :=
  ⟨(a.pos ^^^ (2^j)) ||| b.pos, a.neg ||| (b.neg ^^^ (2^j))⟩

lemma combineAt_sound {v : ℕ→Bool} {a b : Clause} (ha : Sat v a) (hb : Sat v b) (i : ℕ) :
    Sat v (combineAt a b i) := by
  cases hi : v i with
  | false =>
    obtain ⟨j,hj⟩ := ha
    use j
    cases hv : v j with
    | false =>
      have hx : a.neg.testBit j=true := by simpa [hv] using hj
      simp [combineAt,Nat.testBit_or,hx]
    | true =>
      have hne : i≠j := by rintro rfl; simp_all
      have hb0 : (2^i:ℕ).testBit j=false := by simp [Nat.testBit_two_pow_of_ne hne]
      have hx : a.pos.testBit j=true := by simpa [hv] using hj
      simp [combineAt,Nat.testBit_or,Nat.testBit_xor,hb0,hx]
  | true =>
    obtain ⟨j,hj⟩ := hb
    use j
    cases hv : v j with
    | true =>
      have hx : b.pos.testBit j=true := by simpa [hv] using hj
      simp [combineAt,Nat.testBit_or,hx]
    | false =>
      have hne : i≠j := by rintro rfl; simp_all
      have hb0 : (2^i:ℕ).testBit j=false := by simp [Nat.testBit_two_pow_of_ne hne]
      have hx : b.neg.testBit j=true := by simpa [hv] using hj
      simp [combineAt,Nat.testBit_or,Nat.testBit_xor,hb0,hx]

def resolve (a b : Clause) :=
  let common := a.pos &&& b.neg
  if common=0 then combineAt b a (b.pos &&& a.neg).log2
  else combineAt a b common.log2

lemma resolve_sound {v : ℕ→Bool} {a b : Clause} (ha : Sat v a) (hb : Sat v b) :
    Sat v (resolve a b) := by
  simp only [resolve]
  split
  · exact combineAt_sound hb ha _
  · exact combineAt_sound ha hb _

def included (a b : Clause) : Bool :=
  (a.pos &&& b.pos == a.pos) && (a.neg &&& b.neg == a.neg)

lemma includedMask {a b i : ℕ} (h : a &&& b = a) (ha : a.testBit i=true) : b.testBit i=true := by
  have hh := congrArg (fun n : ℕ => n.testBit i) h
  simpa [Nat.testBit_and,ha] using hh

lemma included_sound {v : ℕ→Bool} {a b : Clause} (hs : Sat v a) (hh : included a b=true) : Sat v b := by
  obtain ⟨i,hi⟩ := hs
  obtain ⟨hp,hn⟩ := Bool.and_eq_true_iff.mp hh
  use i
  cases hv : v i with
  | true => simpa [hv] using includedMask (eq_of_beq hp) (show a.pos.testBit i=true by simpa [hv] using hi)
  | false => simpa [hv] using includedMask (eq_of_beq hn) (show a.neg.testBit i=true by simpa [hv] using hi)

def run (db : ℕ→Clause) (row base : ℕ) (goal : Clause) : ℕ → ℕ → Clause → Bool
  | 0, _, _ => false
  | gas+1, tape, cur =>
    if tape=0 then included cur goal
    else let d := tape%base
         decide (0<d ∧ d<row) && run db row base goal gas (tape/base) (resolve cur (db d))

lemma run_sound {v : ℕ→Bool} {db : ℕ→Clause} {row base : ℕ} {goal : Clause}
    (prev : ∀ j, 0<j → j<row → Sat v (db j)) (gas tape : ℕ) (cur : Clause) (hc : Sat v cur)
    (hw : run db row base goal gas tape cur=true) : Sat v goal := by
  induction gas generalizing tape cur with
  | zero => simp [run] at hw
  | succ gas ih =>
    simp only [run] at hw
    split at hw
    · exact included_sound hc hw
    · obtain ⟨hok,hnext⟩ := Bool.and_eq_true_iff.mp hw
      obtain ⟨hpos,hlt⟩ := of_decide_eq_true hok
      exact ih _ _ (resolve_sound hc (prev _ hpos hlt)) hnext

def checked (db : ℕ→Clause) (base gas row word : ℕ) :=
  let start := word%base
  decide (0<start ∧ start<row) && run db row base (db row) gas (word/base) (db start)

lemma checked_sound {v : ℕ→Bool} {db : ℕ→Clause} {base gas row word : ℕ}
    (prev : ∀ j, 0<j → j<row → Sat v (db j)) (hw : checked db base gas row word=true) : Sat v (db row) := by
  obtain ⟨h,hnext⟩ := Bool.and_eq_true_iff.mp hw
  obtain ⟨hp,hl⟩ := of_decide_eq_true h
  exact run_sound prev _ _ _ (prev _ hp hl) hnext

abbrev I := Fin 9
abbrev Trip := I × I × I

def triples : List Trip := (List.finRange 9).flatMap fun a =>
  (List.finRange 9).flatMap fun b => (List.finRange 9).filterMap fun c =>
    if a<b ∧ b<c then some (a,b,c) else none

def tid (a b c : I) := triples.idxOf (a,b,c)
def tr (i : ℕ) := triples[i]?.getD (0,0,0)
def value (color : I→I→I→Bool) (i : ℕ) :=
  let t := tr i
  color t.1 t.2.1 t.2.2

lemma tripCorrect : ∀ a b c : I, a<b → b<c → tr (tid a b c)=(a,b,c) := by decide +kernel

lemma value_id (color : I→I→I→Bool) {a b c : I} (hab : a<b) (hbc : b<c) :
    value color (tid a b c)=color a b c := by simp [value,tripCorrect a b c hab hbc]

def Valid (color : I→I→I→Bool) : Prop := ∀ a b c d : I, a<b → b<c → c<d →
  (color a b c=color a b d ∧ color a b d=color a c d) ∨
  (color a b c=color a b d ∧ color a c d=color b c d) ∨
  (color a b d=color a c d ∧ color a c d=color b c d)

def Pentagon (color : I→I→I→Bool) : Prop := ∃ T : Finset I, T.card=5 ∧
  ∀ a∈T, ∀ b∈T, ∀ c∈T, ∀ d∈T, a<b → b<c → c<d →
    color a b c=color a b d ∧ color a c d=color b c d

def literals : List (ℕ × Bool) → Clause
  | [] => ⟨0,0⟩
  | (i,b)::ls =>
    let c := literals ls
    if b then ⟨2^i ||| c.pos,c.neg⟩ else ⟨c.pos,2^i ||| c.neg⟩

lemma literal_ok (v : ℕ→Bool) (ls : List (ℕ×Bool)) {i : ℕ} {b : Bool}
    (hm : (i,b)∈ls) (hi : v i=b) : Sat v (literals ls) := by
  suffices h : (if b then (literals ls).pos else (literals ls).neg).testBit i=true from
    ⟨i,by simpa [hi] using h⟩
  induction ls with
  | nil => simp at hm
  | cons head tail ih =>
    rcases head with ⟨j,c⟩
    rcases List.mem_cons.mp hm with h|h
    · cases h
      cases b <;> simp [literals,Nat.testBit_or]
    · specialize ih h
      cases b <;> cases c <;> simp_all [literals,Nat.testBit_or]

lemma denied {v : ℕ→Bool} {ls : List (ℕ×Bool)} (hs : ¬Sat v (literals ls)) {i : ℕ} {b : Bool}
    (hm : (i,!b)∈ls) : v i=b := by
  have hne := fun hv => hs (literal_ok v ls hm hv)
  cases b <;> cases h : v i <;> simp_all

def quadL (a b c d : I) (p : ℕ) : List (ℕ×Bool) :=
  [(tid a b c,!(p.testBit 0)),(tid a b d,!(p.testBit 1)),
   (tid a c d,!(p.testBit 2)),(tid b c d,!(p.testBit 3))]

def quadOK (a b c d : I) (p : ℕ) : Bool :=
  decide (a<b ∧ b<c ∧ c<d ∧ ¬ ((p.testBit 0=p.testBit 1 ∧ p.testBit 1=p.testBit 2) ∨
    (p.testBit 0=p.testBit 1 ∧ p.testBit 2=p.testBit 3) ∨
    (p.testBit 1=p.testBit 2 ∧ p.testBit 2=p.testBit 3)))

lemma quad_sound (color : I→I→I→Bool) (hc : Valid color) {a b c d : I} {p : ℕ}
    (hok : quadOK a b c d p=true) : Sat (value color) (literals (quadL a b c d p)) := by
  obtain ⟨hab,hbc,hcd,hbad⟩ := of_decide_eq_true hok
  by_contra h
  have h0 := denied h (i:=tid a b c) (b:=p.testBit 0) (by simp [quadL])
  have h1 := denied h (i:=tid a b d) (b:=p.testBit 1) (by simp [quadL])
  have h2 := denied h (i:=tid a c d) (b:=p.testBit 2) (by simp [quadL])
  have h3 := denied h (i:=tid b c d) (b:=p.testBit 3) (by simp [quadL])
  rw [value_id color hab hbc] at h0
  rw [value_id color hab (hbc.trans hcd)] at h1
  rw [value_id color (hab.trans hbc) hcd] at h2
  rw [value_id color hbc hcd] at h3
  exact hbad (by simpa [←h0,←h1,←h2,←h3] using hc a b c d hab hbc hcd)

def fiveL (s : List I) (p : ℕ) : List (ℕ×Bool) :=
  s.flatMap fun a => s.flatMap fun b => s.filterMap fun c =>
    if a<b ∧ b<c then some (tid a b c,!(p.testBit b.val)) else none

lemma memFive {s : List I} (p : ℕ) {a b c : I} (ha : a∈s) (hb : b∈s) (hc : c∈s)
    (hab : a<b) (hbc : b<c) : (tid a b c,!(p.testBit b.val)) ∈ fiveL s p := by
  apply List.mem_flatMap.mpr ⟨a,ha,?_⟩
  apply List.mem_flatMap.mpr ⟨b,hb,?_⟩
  exact List.mem_filterMap.mpr ⟨c,hc,by simp [hab,hbc]⟩

lemma five_sound (color : I→I→I→Bool) (hn : ¬Pentagon color) (s : List I) (p : ℕ)
    (hc : s.toFinset.card=5) : Sat (value color) (literals (fiveL s p)) := by
  by_contra h
  apply hn
  refine ⟨s.toFinset,hc,?_⟩
  have uniform {a b c : I} (ha : a∈s) (hb : b∈s) (hc : c∈s) (hab : a<b) (hbc : b<c) :
      color a b c = p.testBit b.val := by
    rw [←value_id color hab hbc]
    exact denied h (memFive p ha hb hc hab hbc)
  simp only [List.mem_toFinset]
  intro a ha b hb c hc d hd hab hbc hcd
  exact ⟨(uniform ha hb hc hab hbc).trans (uniform ha hb hd hab (hbc.trans hcd)).symm,
    (uniform ha hc hd (hab.trans hbc) hcd).trans (uniform hb hc hd hbc hcd).symm⟩
