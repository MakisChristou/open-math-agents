import FormalConjectures.OEIS.«261680»
import Mathlib.Data.Nat.Bitwise

/-! Rajasekaran, Shallit and Smith proved that four binary palindromes
suffice. We use their three possible length patterns for odd integers.
Reading the low and high digits together gives a finite search with a
carry at each end. Each collection is a set of possible carries after
a prefix of paired digits. For either choice of the next low and high bits,
the image contains another listed collection. Every listed collection
covers all middle words of width four and five. Induction on the width
therefore proves coverage for arbitrary words. The finite inclusion and
base-case certificates are checked in the Lean kernel. -/

namespace OMA.BinaryPals
open OeisA261680 Finset

def wrap (w b x : ℕ) := 2*x+b*(2^(w+1)+1)

def pals : ℕ → List ℕ
  | 0 => [0]
  | 1 => [0,1]
  | w+2 => (pals w).flatMap (fun x => [wrap w 0 x,wrap w 1 x])

lemma wrap_mem {w b x : ℕ} (hx : x ∈ pals w) (hb : b≤1) : wrap w b x ∈ pals (w+2) := by
  apply List.mem_flatMap.mpr
  exact ⟨x,hx,by interval_cases b <;> simp⟩

lemma word {w x : ℕ} (hx : x ∈ pals w) :
    ∃ ds : List ℕ, ds.length=w ∧ ds.reverse=ds ∧ (∀ d ∈ ds, d<2) ∧ Nat.ofDigits 2 ds=x := by
  induction w using Nat.twoStepInduction generalizing x with
  | zero =>
    have hx' : x=0 := by simpa [pals] using hx
    exact ⟨[],by simp [hx']⟩
  | one =>
    have hx' : x=0 ∨ x=1 := by simpa [pals] using hx
    exact ⟨[x],by simp [Nat.ofDigits_singleton]; omega⟩
  | more w ih _ =>
    obtain ⟨v,hv,hh⟩ := List.mem_flatMap.mp hx
    obtain ⟨ds,hl,hr,hd,he⟩ := ih hv
    have make (b : ℕ) (hb : b≤1) : ∃ ds' : List ℕ, ds'.length = w+2 ∧ ds'.reverse=ds' ∧
        (∀ d ∈ ds', d<2) ∧ Nat.ofDigits 2 ds'=wrap w b v := by
      refine ⟨b::(ds++[b]),by simp [hl],by simp [hr],?_,?_⟩
      · intro d hm
        simp only [List.mem_cons,List.mem_append,List.not_mem_nil,or_false] at hm
        rcases hm with rfl|hm|rfl
        · omega
        · exact hd d hm
        · omega
      · simp [Nat.ofDigits_cons,Nat.ofDigits_append,hl,he,wrap,pow_succ]
        ring
    simp only [List.mem_cons,List.not_mem_nil,or_false] at hh
    rcases hh with rfl|rfl
    · exact make 0 (by decide)
    · exact make 1 (by decide)

lemma canonical_wrap {w x : ℕ} (hx : x ∈ pals w) :
    isBinaryPalindrome (wrap w 1 x) = true := by
  obtain ⟨ds,hl,hr,hd,he⟩ := word hx
  let ds' := 1::(ds++[1])
  have hval : Nat.ofDigits 2 ds' = wrap w 1 x := by
    simp [ds',Nat.ofDigits_cons,Nat.ofDigits_append,he,hl,wrap,pow_succ]
    ring
  have hbits (d : ℕ) (h : d ∈ ds') : d<2 := by
    simp only [ds',List.mem_cons,List.mem_append,List.not_mem_nil,or_false] at h
    rcases h with rfl|h|rfl <;> first | decide | exact hd d h
  have hds := Nat.digits_ofDigits 2 (by decide) ds' hbits (by simp [ds'])
  simp [isBinaryPalindrome,←hval,hds,ds',hr]

def fits (outer : Bool) (w x : ℕ) := x ∈ pals w ∧ (outer=true → isBinaryPalindrome x=true)

lemma lift_wrap {outer : Bool} {w b x : ℕ} (hb : b≤1) (h : outer=true → b=1)
    (hx : x ∈ pals w) : fits outer (w+2) (wrap w b x) :=
  ⟨wrap_mem hx hb,fun ho => h ho ▸ canonical_wrap hx⟩

def firstW (m w : ℕ) := if m=1 then w-1 else w
def secondW (m w : ℕ) := if m=2 then 0 else w-2
def thirdW (m w : ℕ) := if m=2 then 0 else w-3

/-- The high carry is stored with a bias of eight. -/
def Rep (outer : Bool) (w T m c h : ℕ) : Prop :=
  ∃ x y z : ℕ, fits outer (firstW m w) x ∧ fits outer (secondW m w) y ∧ fits outer (thirdW m w) z ∧
    x+y+z+c+8*2^(w-3) = T+h*2^(w-3)

def highWeight (m a b d : ℕ) := (if m=1 then 4 else 8)*a+2*b+d

lemma lift {w T m c h c' h' a b d l u : ℕ} {outer : Bool}
    (hw : 4≤w) (hm : m<3) (ha : a≤1) (hb : b≤1) (hd : d≤1)
    (hzero : m=2 → b=0 ∧ d=0) (hout : outer=true → a=1 ∧ (m≠2 → b=1 ∧ d=1))
    (hL : 2*c'+l=c+a+b+d) (hH : h'+highWeight m a b d+8=2*h+8*u)
    (hr : Rep false w T m c' h') : Rep outer (w+2) (l+2*T+u*2^(w+1)) m c h := by
  obtain ⟨x,y,z,hx,hy,hz,he⟩ := hr
  have hbnd : fits outer 0 0 := ⟨by decide,fun _ => by decide⟩
  obtain ⟨v,hv⟩ := Nat.exists_eq_add_of_le hw
  subst w
  have hx' := lift_wrap ha (fun ho => (hout ho).1) hx.1
  by_cases h2 : m=2
  · subst m
    obtain ⟨rfl,rfl⟩ := hzero rfl
    have y0 : y=0 := by simpa [secondW,pals] using hy.1
    have z0 : z=0 := by simpa [thirdW,pals] using hz.1
    subst y
    subst z
    refine ⟨_,0,0,hx',hbnd,hbnd,?_⟩
    simp only [firstW,show ¬2=1 by decide,if_false] at hx' ⊢
    simp [highWeight] at hH
    simp only [wrap,firstW,show ¬2=1 by decide,if_false,add_zero] at *
    simp only [show 4+v-3=v+1 by omega,show 4+v+2-3=v+3 by omega,
      show 4+v+1=v+5 by omega,pow_add] at *
    norm_num1 at *
    nlinarith only [he,hL,congrArg (fun a : ℕ => a*2^v) hH]
  · have hy' := lift_wrap hb (fun ho => ((hout ho).2 h2).1) hy.1
    have hz' := lift_wrap hd (fun ho => ((hout ho).2 h2).2) hz.1
    have eq1 : firstW m (4+v+2) = firstW m (4+v)+2 := by unfold firstW; split <;> omega
    have eq2 : secondW m (4+v+2) = secondW m (4+v)+2 := by simp [secondW,h2]; omega
    have eq3 : thirdW m (4+v+2) = thirdW m (4+v)+2 := by simp [thirdW,h2]; omega
    refine ⟨_,_,_,eq1 ▸ hx',eq2 ▸ hy',eq3 ▸ hz',?_⟩
    by_cases h1 : m=1 <;> simp [wrap,firstW,secondW,thirdW,highWeight,h1,h2,
      show 4+v=v+4 by omega,show v+4-3=v+1 by omega,show v+4-2=v+2 by omega,
      show v+4-1=v+3 by omega,show v+4+2-3=v+3 by omega,←Nat.add_assoc,pow_succ] at hH he ⊢ <;>
      nlinarith only [he,hL,congrArg (fun a : ℕ => a*2^v) hH]

def codeNext (s k l u : ℕ) : ℕ :=
  let a := k%2
  let b := k/2%2
  let d := k/4
  let low := s/20%3+a+b+d
  let high := 2*(s%20)+8*u
  let cost := highWeight (s/60) a b d+8
  if (s/60≠2 ∨ b=0 ∧ d=0) ∧ l≤low ∧ (low-l)%2=0 ∧ (low-l)/2<3 ∧ cost≤high ∧ high-cost<20
  then 60*(s/60)+20*((low-l)/2)+(high-cost) else 180

def maskOf (f : ℕ → ℕ) : List ℕ → ℕ
  | [] => 0
  | x::xs => f x ||| maskOf f xs

lemma maskOf_sound {f : ℕ → ℕ} {xs : List ℕ} {p : ℕ} (h : (maskOf f xs).testBit p = true) :
    ∃ x ∈ xs, (f x).testBit p = true := by
  induction xs with
  | nil => simp [maskOf] at h
  | cons x xs ih =>
    simp only [maskOf,Nat.testBit_or,Bool.or_eq_true] at h
    rcases h with h|h
    · exact ⟨x,by simp,h⟩
    · obtain ⟨y,hy,hh⟩ := ih h
      exact ⟨y,by simp [hy],hh⟩

def edge (s l u : ℕ) := maskOf (fun k => 2^(codeNext s k l u)) (List.range 8)
def post (mask l u : ℕ) := maskOf (fun s => if mask.testBit s then edge s l u else 0) (List.range 180)
def Good (M w T : ℕ) := ∃ s<180, M.testBit s=true ∧ Rep false w T (s/60) (s/20%3) (s%20)

lemma decode {m c h t : ℕ} (he : 60*m+20*c+h=t) (hc : c<3) (hh : h<20) :
    t/60=m ∧ t/20%3=c ∧ t%20=h := by omega

lemma codeLift {s k l u t w T : ℕ} (hs : s<180) (hk : k<8) (ht : t<180) (hw : 4≤w)
    (he : codeNext s k l u=t) (hr : Rep false w T (t/60) (t/20%3) (t%20)) :
    Rep false (w+2) (l+2*T+u*2^(w+1)) (s/60) (s/20%3) (s%20) := by
  let a := k%2
  let b := k/2%2
  let d := k/4
  let c := (s/20%3+a+b+d-l)/2
  let h := 2*(s%20)+8*u-(highWeight (s/60) a b d+8)
  change (if _ then 60*(s/60)+20*c+h else 180)=t at he
  split at he
  · rename_i H
    obtain ⟨hmode,hlo,hpar,hc,hhi,hh⟩ := H
    change c<3 at hc
    change h<20 at hh
    obtain ⟨hm,hc',hh'⟩ := decode he hc hh
    rw [hm,hc',hh'] at hr
    apply lift hw (by omega) (a:=a) (b:=b) (d:=d) (by dsimp [a]; omega)
      (by dsimp [b]; omega) (by dsimp [d]; omega) _ (by simp) _ _ hr
    · exact fun h2 => hmode.resolve_left (by omega)
    · dsimp [c,a,b,d] at *
      omega
    · dsimp [h,a,b,d] at *
      omega
  · omega

lemma liftPost {M l u t w T : ℕ} (ht : t<180) (hw : 4≤w) (hp : (post M l u).testBit t=true)
    (hr : Rep false w T (t/60) (t/20%3) (t%20)) : Good M (w+2) (l+2*T+u*2^(w+1)) := by
  obtain ⟨s,hs,he⟩ := maskOf_sound hp
  replace hs := List.mem_range.mp hs
  by_cases hM : M.testBit s=true
  · simp only [hM,if_true] at he
    obtain ⟨k,hk,he⟩ := maskOf_sound he
    have he' := (of_decide_eq_true (by simpa only [Nat.testBit_two_pow] using he) : codeNext s k l u=t)
    exact ⟨s,hs,hM,codeLift hs (List.mem_range.mp hk) ht hw he' hr⟩
  · simp [hM] at he

def baseAccept (w T s : ℕ) :=
  (pals (firstW (s/60) w)).any fun x =>
    (pals (secondW (s/60) w)).any fun y =>
      (pals (thirdW (s/60) w)).any fun z =>
        decide (x+y+z+s/20%3+8*2^(w-3)=T+(s%20)*2^(w-3))

def baseMask (w T : ℕ) := maskOf (fun s => if baseAccept w T s then 2^s else 0) (List.range 180)

lemma baseGood {M w T : ℕ} (h : M &&& baseMask w T ≠ 0) : Good M w T := by
  obtain ⟨s,hs⟩ : ∃ s, (M &&& baseMask w T).testBit s=true := by
    by_contra! H
    apply h
    apply Nat.eq_of_testBit_eq
    intro i
    simpa using H i
  simp only [Nat.testBit_and,Bool.and_eq_true] at hs
  obtain ⟨s',hs',he⟩ := maskOf_sound hs.2
  by_cases ha : baseAccept w T s'=true
  · simp only [ha,if_true,Nat.testBit_two_pow,decide_eq_true_eq] at he
    subst s'
    simp only [baseAccept,List.any_eq_true,decide_eq_true_eq] at ha
    obtain ⟨x,hx,y,hy,z,hz,he⟩ := ha
    exact ⟨s,List.mem_range.mp hs',hs.1,x,y,z,⟨hx,by simp⟩,⟨hy,by simp⟩,⟨hz,by simp⟩,he⟩
  · simp [ha] at he

lemma subBit {A B s : ℕ} (h : A &&& B = B) (hb : B.testBit s=true) : A.testBit s=true := by
  have := congrArg (fun x : ℕ => x.testBit s) h
  simpa [hb] using this

end OMA.BinaryPals

