open OeisA261680 Finset

lemma nextCollection {M : ℕ} {row : List ℕ} (hok : transOK M row=true) {l u : ℕ} (hl : l<2) (hu : u<2) :
    ∃ M' ∈ family, post M l u &&& M' = M' := by
  have h := List.all_eq_true.mp hok (l+2*u) (List.mem_range.mpr (by omega))
  have hbit : (l+2*u)%2=l := by omega
  have hhigh : (l+2*u)/2=u := by omega
  simpa only [hbit,hhigh,Bool.and_eq_true,List.contains_iff_mem,decide_eq_true_eq] using
    (show ∃ M' : ℕ, (family.contains M' && decide (post M ((l+2*u)%2) ((l+2*u)/2) &&& M'=M')) = true
       from ⟨row[l+2*u]!,h⟩)

lemma familyRow {M : ℕ} (hm : M ∈ family) : ∃ row, transOK M row=true := by
  obtain ⟨r,hr,he⟩ := List.mem_map.mp hm
  exact ⟨r.2,he ▸ List.all_eq_true.mp certifiedSteps r hr⟩

lemma lookupMem {xs : List ℕ} {i : ℕ} (h : i<xs.length) : xs[i]! ∈ xs := by
  rw [getElem!_pos xs i h]
  exact List.getElem_mem h

lemma goodBase {M w T : ℕ} (hm : M∈family) (hw : w=4 ∨ w=5) (hT : T<2^w) : Good M w T := by
  have hb := List.all_eq_true.mp certifiedBases M hm
  simp only [baseOK,Bool.and_eq_true] at hb
  obtain ⟨hb4,hb5⟩ := hb
  rcases hw with rfl|rfl
  · have hi : T<16 := hT
    have he := of_decide_eq_true (List.all_eq_true.mp certifiedFour T (List.mem_range.mpr hi))
    have ht : T<small4.length := hi
    exact baseGood (he ▸ of_decide_eq_true (List.all_eq_true.mp hb4 _ (lookupMem ht)))
  · have hi : T<32 := hT
    have he := of_decide_eq_true (List.all_eq_true.mp certifiedFive T (List.mem_range.mpr hi))
    have ht : T<small5.length := hi
    exact baseGood (he ▸ of_decide_eq_true (List.all_eq_true.mp hb5 _ (lookupMem ht)))

lemma peel {k N : ℕ} (hn : N<2^(k+2)) :
    ∃ l u T : ℕ, l<2 ∧ u<2 ∧ T<2^k ∧ N=l+2*T+u*2^(k+1) := by
  have hp : 0<2^k := pow_pos (by decide) _
  have hq : 0<2^(k+1) := pow_pos (by decide) _
  have hu : N/2^(k+1)<2 := (Nat.div_lt_iff_lt_mul hq).mpr (by simpa [pow_succ,Nat.mul_comm] using hn)
  refine ⟨N%2,N/2^(k+1),N/2%2^k,by omega,hu,Nat.mod_lt _ hp,?_⟩
  have eq := Nat.mod_add_div N (2^(k+1))
  have hr : N%2^(k+1)=N%2+2*(N/2%2^k) := by rw [pow_succ',Nat.mod_mul]
  rw [hr,Nat.mul_comm (2^(k+1))] at eq
  exact eq.symm

lemma extend {k N M : ℕ} (hk : 4≤k) (hN : N<2^(k+2)) {row : List ℕ} (hr : transOK M row=true)
    (ih : ∀ M' ∈ family, ∀ T<2^k, Good M' k T) : Good M (k+2) N := by
  obtain ⟨l,u,T,hl,hu,ht,rfl⟩ := peel hN
  obtain ⟨M',hm',he⟩ := nextCollection hr hl hu
  obtain ⟨s,hs,hbit,hrep⟩ := ih M' hm' T ht
  exact liftPost hs hk (subBit he hbit) hrep

lemma familyGood (w : ℕ) (hw : 4≤w) (M : ℕ) (hm : M ∈ family) (T : ℕ) (hT : T<2^w) : Good M w T := by
  induction w using Nat.strong_induction_on generalizing M T with
  | h w ih =>
    by_cases h : w≤5
    · exact goodBase hm (by omega) hT
    · obtain ⟨k,rfl⟩ : ∃ k, w=k+2 := ⟨w-2,by omega⟩
      obtain ⟨row,hr⟩ := familyRow hm
      exact extend (by omega) hT hr (fun M' hm' T ht => ih k (by omega) (by omega) M' hm' T ht)

lemma initGood {w T : ℕ} (hw : 6≤w) (hT : T<2^w) : Good init w T := by
  obtain ⟨k,rfl⟩ : ∃ k, w=k+2 := ⟨w-2,by omega⟩
  exact extend (by omega) hT certifiedInit (familyGood k (by omega))

def Three (N : ℕ) := ∃ x y z : ℕ, isBinaryPalindrome x=true ∧ isBinaryPalindrome y=true ∧
    isBinaryPalindrome z=true ∧ x+y+z=N

lemma finish {w N m : ℕ} (hr : Rep true w N m 0 8) : Three N := by
  obtain ⟨x,y,z,hx,hy,hz,he⟩ := hr
  exact ⟨x,y,z,hx.2 rfl,hy.2 rfl,hz.2 rfl,by omega⟩

lemma largeOdd {N : ℕ} (hN : 128≤N) (ho : N%2=1) : Three N := by
  have hlog : 7 ≤ Nat.log 2 N := (Nat.le_log_iff_pow_le (by decide) (by omega)).mpr hN
  obtain ⟨w,hw,he⟩ : ∃ w, 6≤w ∧ Nat.log 2 N=w+1 := ⟨Nat.log 2 N-1,by omega,by omega⟩
  have hu : N<2^(w+2) := by simpa only [he] using Nat.lt_pow_succ_log_self (by decide : 1<2) N
  have hlow : 2^(w+1)≤N := he ▸ Nat.pow_log_le_self 2 (by omega : N≠0)
  obtain ⟨l,u,T,hl,hu',ht,eq⟩ := peel hu
  have hpow : 2^(w+1)=2*2^w := pow_succ' 2 w
  have hu1 : u=1 := by
    rcases Nat.eq_zero_or_pos u with h|h
    · simp [h] at eq
      omega
    · omega
  subst u
  have hl1 : l=1 := by rw [eq,hpow,one_mul] at ho; omega
  subst l
  obtain ⟨s,hs,hbit,hr⟩ := initGood hw ht
  simp only [init,Nat.testBit_or,Bool.or_eq_true,Nat.testBit_two_pow,decide_eq_true_eq] at hbit
  rw [eq]
  rcases hbit with (rfl|rfl)|rfl
  · exact finish (lift (outer:=true) (m:=0) (c:=0) (h:=8) (a:=1) (b:=1) (d:=1)
      (by omega) (by decide) (by decide) (by decide) (by decide) (by simp) (by simp) (by decide) (by decide) hr)
  · exact finish (lift (outer:=true) (m:=1) (c:=0) (h:=8) (a:=1) (b:=1) (d:=1)
      (by omega) (by decide) (by decide) (by decide) (by decide) (by simp) (by simp) (by decide) (by decide) hr)
  · exact finish (lift (outer:=true) (m:=2) (c:=0) (h:=8) (a:=1) (b:=0) (d:=0)
      (by omega) (by decide) (by decide) (by decide) (by decide) (by simp) (by simp) (by decide) (by decide) hr)

def smallPals : List ℕ := [0,1,3,5,7,9,15,17,21,27,31,33,45,51,63,65,73,85,93,99,107,119,127]

lemma oddThree {N : ℕ} (ho : N%2=1) : Three N := by
  by_cases hN : 128≤N
  · exact largeOdd hN ho
  · have hsmall : smallPals.all isBinaryPalindrome = true := by decide +kernel
    have hcert : ((List.range 128).all fun n => decide (n%2≠1) || (smallPals.any fun x =>
      smallPals.any fun y => smallPals.any fun z => decide (x+y+z=n)))=true := by decide +kernel
    have hh := List.all_eq_true.mp hcert N (List.mem_range.mpr (by omega))
    simp only [ho,ne_eq,not_true_eq_false,decide_false,Bool.false_or,List.any_eq_true,decide_eq_true_eq] at hh
    obtain ⟨x,hx,y,hy,z,hz,he⟩ := hh
    exact ⟨x,y,z,List.all_eq_true.mp hsmall _ hx,List.all_eq_true.mp hsmall _ hy,List.all_eq_true.mp hsmall _ hz,he⟩

lemma four {N : ℕ} : ∃ x y z v : ℕ, isBinaryPalindrome x=true ∧ isBinaryPalindrome y=true ∧
    isBinaryPalindrome z=true ∧ isBinaryPalindrome v=true ∧ x+y+z+v=N := by
  by_cases hn : N=0
  · exact ⟨0,0,0,0,by decide,by decide,by decide,by decide,by omega⟩
  by_cases hodd : N%2=1
  · obtain ⟨x,y,z,hx,hy,hz,he⟩ := oddThree hodd
    exact ⟨x,y,z,0,hx,hy,hz,by decide,by omega⟩
  · obtain ⟨x,y,z,hx,hy,hz,he⟩ := oddThree (show (N-1)%2=1 by omega)
    exact ⟨x,y,z,1,hx,hy,hz,by decide,by omega⟩

end OMA.BinaryPals

theorem OMA.solution : type_of% @OeisA261680.conjecture := by
  intro N
  obtain ⟨x,y,z,v,hx,hy,hz,hv,he⟩ := OMA.BinaryPals.four (N:=N)
  unfold OeisA261680.a
  apply Finset.sum_pos_iff.mpr
  refine ⟨x,Finset.mem_range.mpr (by omega),Finset.sum_pos_iff.mpr ⟨y,Finset.mem_range.mpr (by omega),?_⟩⟩
  apply Finset.sum_pos_iff.mpr
  refine ⟨z,Finset.mem_range.mpr (by omega),?_⟩
  have eq : N-(x+y+z)=v := by omega
  simp [eq,hx,hy,hz,hv]
