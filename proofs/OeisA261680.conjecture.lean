def transOK (M : ℕ) (row : List ℕ) := (List.range 4).all fun j =>
  let child := row[j]!
  family.contains child && decide (post M (j%2) (j/2) &&& child = child)

def baseOK (M : ℕ) :=
  small4.all (fun z => decide (M &&& z ≠ 0)) && small5.all (fun z => decide (M &&& z ≠ 0))

set_option maxRecDepth 1000000 in
lemma certifiedFour : ((List.range 16).all fun T => decide (small4[T]! = baseMask 4 T))=true := by decide +kernel
set_option maxRecDepth 1000000 in
lemma certifiedFive : ((List.range 32).all fun T => decide (small5[T]! = baseMask 5 T))=true := by decide +kernel
set_option maxRecDepth 1000000 in
lemma certifiedBases : family.all baseOK=true := by decide +kernel
set_option maxRecDepth 1000000 in
lemma certifiedInit : transOK init initRow=true := by decide +kernel
set_option maxRecDepth 1000000 in
lemma certifiedSteps : book.all (fun row => transOK row.1 row.2)=true := by decide +kernel

end OMA.BinaryPals

