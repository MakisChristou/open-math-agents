lemma indices : rows.map Sigma.fst = List.range 512 := by decide +kernel

lemma witness {q : ℕ} (hp : q.Prime) (hq : q<2^17) : ∃ g, certOK q g=true := by
  rcases hp.eq_two_or_odd with rfl|ho
  · exact ⟨0,by decide +kernel⟩
  · have hm : q/256 ∈ rows.map Sigma.fst := by rw [indices,List.mem_range]; omega
    obtain ⟨row,_,he⟩ := List.mem_map.mp hm
    have hrow := List.all_eq_true.mp row.2.2 (q/2%128) (List.mem_range.mpr (by omega))
    have heq : 2*(128*row.1+q/2%128)+1=q := by omega
    exact ⟨_,heq ▸ hrow⟩

end OMA.SmallUnits

theorem OMA.solution : OMA.R_Erdos770_erdos_770_parts_iii_R1.H2 := by
  intro q hp hq H hH
  obtain ⟨g,hg⟩ := OMA.SmallUnits.witness hp hq
  exact OMA.SmallUnits.sound hp hq hg H hH
