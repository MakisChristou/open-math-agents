import OMAReductions.R_Erdos770_erdos_770_parts_iii_R1
import Mathlib.Analysis.Complex.ExponentialBounds

/-! The small-modulus bound follows by finding a small primitive root modulo
each prime. Modular exponentiation tests one exponent for each prime divisor
of the order. The order of any proper subgroup divides one of those exponents. -/

namespace OMA.SmallUnits

def powMod (q a e : ℕ) : ℕ → ℕ
  | 0 => 1
  | k+1 => if e=0 then 1 else
    let v := powMod q a (e/2) k
    let t := v*v%q
    if e%2=0 then t else t*a%q

lemma powMod_cast {q a e f : ℕ} (h : e<2^f) :
    (powMod q a e f : ZMod q)=(a : ZMod q)^e := by
  induction f generalizing e with
  | zero =>
    have : e=0 := by simpa using h
    simp [this,powMod]
  | succ f ih =>
    have he : e/2<2^f := by rw [pow_succ] at h; omega
    by_cases h0 : e=0
    · simp [powMod,h0]
    · simp only [powMod,h0,if_false]
      split
      · rename_i hb
        have hx : e/2*2=e := by omega
        simp only [ZMod.natCast_mod,Nat.cast_mul,ih he,←pow_add]
        congr 1
        omega
      · rename_i hb
        simp only [ZMod.natCast_mod,Nat.cast_mul,ih he,←pow_add,←pow_succ]
        congr 1
        omega

lemma powMod_lt {q a e : ℕ} (h : 1<q) (f : ℕ) : powMod q a e f < q := by
  cases f with
  | zero => exact h
  | succ f => simp only [powMod]; split <;> first | exact h | split <;> exact Nat.mod_lt _ (by omega)

def bound (q : ℕ) := 4*(Nat.log 3 q)^2

lemma bound_le {q : ℕ} (hq : 3≤q) : (bound q : ℝ) ≤ 21/5 * Real.log q^2 := by
  let k := Nat.log 3 q
  have h₁ : (3 : ℝ)^k ≤ q := by exact_mod_cast Nat.pow_log_le_self 3 (by omega : q≠0)
  have h₂ := Real.log_le_log (by positivity) h₁
  rw [Real.log_pow] at h₂
  have h₃ : 1 ≤ Real.log 3 := (Real.le_log_iff_exp_le (by norm_num)).mpr Real.exp_one_lt_three.le
  have hk : (k : ℝ) ≤ Real.log q := (le_mul_of_one_le_right (by positivity) h₃).trans h₂
  have hsq := pow_le_pow_left₀ (by positivity : 0 ≤ (k:ℝ)) hk 2
  change ((4*k^2 : ℕ):ℝ) ≤ _
  push_cast
  nlinarith [sq_nonneg (Real.log q)]

def generatorOK (q g : ℕ) (ds : List ℕ) := decide (0<g ∧ g<q ∧ g≤bound q) &&
  ds.all (fun r => decide (powMod q g ((q-1)/r) 17 ≠ 1))

def certOK (q w : ℕ) := decide (q<3 ∨ (1<w ∧ w<q ∧ q%w=0)) ||
  generatorOK q w (q-1).primeFactorsList

def packedEntry (c i : ℕ) := (c >>> (9*i)) % 512
def blockOK (block code : ℕ) := (List.range 128).all fun j =>
  certOK (2*(128*block+j)+1) (packedEntry code j)

lemma sound {q g : ℕ} (hq : q.Prime) (hlim : q<2^17) (hok : certOK q g=true)
    (H : Subgroup (ZMod q)ˣ) (hH : H ≠ ⊤) :
    ∃ a : (ZMod q)ˣ, a ∉ H ∧ ((a : ZMod q).val : ℝ) ≤ 21 / 5 * Real.log q ^ 2 := by
  have : Fact q.Prime := ⟨hq⟩
  have hc : Nat.card (ZMod q)ˣ=q-1 := by rw [Nat.card_eq_fintype_card,ZMod.card_units_eq_totient,Nat.totient_prime hq]
  have hdvd := H.card_subgroup_dvd_card
  have hne : Nat.card H ≠ Nat.card (ZMod q)ˣ := fun he => hH ((Subgroup.card_eq_iff_eq_top (H:=H)).mp he)
  rw [hc] at hdvd hne
  have hpos := Nat.card_pos (α:=H)
  obtain ⟨k,hk⟩ := hdvd
  have hp := hq.two_le
  have hk1 : 1<k := by
    by_contra! hh
    interval_cases k <;> simp_all
  have h3 : 3≤q := by
    have := Nat.le_mul_of_pos_left k hpos
    omega
  have hg : generatorOK q g (q-1).primeFactorsList=true := by
    simp only [certOK,Bool.or_eq_true,decide_eq_true_eq] at hok
    rcases hok with (hlt|⟨hg1,hgq,hmod⟩)|hg
    · omega
    · have := (Nat.dvd_prime hq).mp (Nat.dvd_of_mod_eq_zero hmod)
      omega
    · exact hg
  simp only [generatorOK,Bool.and_eq_true,decide_eq_true_eq,List.all_eq_true] at hg
  obtain ⟨⟨hg0,hgq,hgb⟩,hg⟩ := hg
  let r := k.minFac
  have hr : r.Prime := Nat.minFac_prime (by omega)
  obtain ⟨s,hs⟩ : r ∣ k := k.minFac_dvd
  have hqr : q-1=r*(Nat.card H*s) := by rw [hk,hs]; ring
  have hm := hg r ((Nat.mem_primeFactorsList (by omega : q-1≠0)).mpr ⟨hr,⟨_,hqr⟩⟩)
  have hdiv : (q-1)/r=Nat.card H*s := by rw [hqr,Nat.mul_div_cancel_left _ hr.pos]
  have hcop : g.Coprime q := (hq.coprime_iff_not_dvd.mpr (Nat.not_dvd_of_pos_of_lt hg0 hgq)).symm
  let a := ZMod.unitOfCoprime g hcop
  refine ⟨a,?_,?_⟩
  · intro ha
    have he : a^((q-1)/r)=1 :=
      orderOf_dvd_iff_pow_eq_one.mp ((H.orderOf_dvd_natCard ha).trans (hdiv ▸ dvd_mul_right _ _))
    have hz : (g : ZMod q)^((q-1)/r)=1 := by simpa [a] using congrArg (fun x : (ZMod q)ˣ => (x : ZMod q)) he
    have hpow : (powMod q g ((q-1)/r) 17 : ZMod q) = 1 :=
      (powMod_cast ((Nat.div_le_self _ _).trans_lt (by omega))).trans hz
    have hval := congrArg ZMod.val hpow
    simp only [ZMod.val_natCast,Nat.mod_eq_of_lt (powMod_lt (q:=q) (a:=g) (e:=(q-1)/r) (by omega) 17),ZMod.val_one] at hval
    exact hm hval
  · simp [a,ZMod.val_natCast_of_lt hgq]
    exact (Nat.cast_le.mpr hgb).trans (bound_le h3)

